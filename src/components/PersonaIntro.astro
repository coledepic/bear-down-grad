---
import Icon from './Icon.astro';

interface Props {
  persona: 'kylie' | 'austin';
  name: string;
  degree: string;
  line: string;
  photo: string;
  /** background-position value ("X% Y%") anchored on the subject, so a cover-cropped
   * full-screen background doesn't crop them out on very tall or very wide viewports.
   * Defaults to plain center. */
  photoFocus?: string;
}
const { persona, name, degree, line, photo, photoFocus = 'center' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!-- Hidden by default; JS opens it. That way a no-JS visitor just gets the site
     rather than an overlay they can't dismiss. -->
<div class="intro" id="intro" data-persona={persona} role="dialog" aria-modal="true" aria-labelledby="intro-name">
  <div class="intro__photo" style={`background-image:url('${base}/images/${photo}');background-position:${photoFocus}`}></div>
  <div class="intro__inner">
    <button type="button" class="intro__close" data-intro-close aria-label="Close">
      <Icon name="close" size={20} />
    </button>
    <div class="intro__eyebrow">You're invited by</div>
    <h1 class="intro__name" id="intro-name">{name}</h1>
    <div class="intro__degree">{degree} · University of Arizona · Spring 2027</div>
    <p class="intro__line">{line}</p>
    <button type="button" class="intro__btn" data-intro-close>
      Let's celebrate <Icon name="right" size={19} />
    </button>
    <button type="button" class="intro__skip" data-intro-close>Skip to the details</button>
  </div>
</div>

<script>
  (function () {
    const intro = document.getElementById('intro');
    if (!intro) return;

    const persona = intro.dataset.persona;
    const key = `bd-intro-${persona}`;
    const forced = new URLSearchParams(window.location.search).has('intro');

    // Once per browsing session, unless ?intro is present (handy for previewing).
    if (!forced && sessionStorage.getItem(key)) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const opener = document.activeElement as HTMLElement | null;

    function open() {
      intro!.classList.add('open');
      document.body.classList.add('locked');
      (intro!.querySelector('.intro__btn') as HTMLButtonElement | null)?.focus();
    }

    function close() {
      try { sessionStorage.setItem(key, '1'); } catch {}
      document.body.classList.remove('locked');
      if (reduced) {
        intro!.classList.remove('open');
      } else {
        intro!.classList.add('closing');
        setTimeout(() => intro!.classList.remove('open', 'closing'), 380);
      }
      document.removeEventListener('keydown', onKey);
      opener?.focus?.();
    }

    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') close();
    }

    intro.querySelectorAll('[data-intro-close]').forEach((b) => b.addEventListener('click', close));
    // Click the backdrop (but not the content) to dismiss.
    intro.addEventListener('click', (e) => {
      if (e.target === intro || (e.target as HTMLElement).classList.contains('intro__photo')) close();
    });
    document.addEventListener('keydown', onKey);

    open();
  })();
</script>
