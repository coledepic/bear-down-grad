---
import Icon from './Icon.astro';

// Formspree form ID (the tail of https://formspree.io/f/<id>). Submissions land in the
// Formspree dashboard + notification email; nothing is stored by this site itself.
const FORMSPREE_ID = 'xzebpgyj';
---
<section class="rsvp container" id="rsvp" data-reveal>
  <div class="rsvp__card">
    <form id="rsvp-form" action={`https://formspree.io/f/${FORMSPREE_ID}`} method="POST">
      <h2>RSVP</h2>
      <p class="lead">One RSVP covers your whole group. Resubmit anytime if plans change.</p>
      <input type="hidden" name="_subject" value="New graduation RSVP" />

      <div class="field-row">
        <div class="field">
          <label for="rsvp-name">Your name</label>
          <input type="text" id="rsvp-name" name="name" required />
        </div>
        <div class="field">
          <label for="rsvp-email">Email</label>
          <input type="email" id="rsvp-email" name="email" required />
        </div>
      </div>

      <div class="field">
        <label>What are you coming to?</label>
        <div class="day-options">
          <label class="day-pill"><input type="checkbox" name="events[]" value="Friday commencement" checked /> Commencement</label>
          <label class="day-pill"><input type="checkbox" name="events[]" value="Saturday party" checked /> The party</label>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="rsvp-guests">Total guests (incl. you)</label>
          <input type="text" inputmode="numeric" id="rsvp-guests" name="guests" placeholder="1" required />
        </div>
        <div class="field">
          <label for="rsvp-notes">Anything we should know?</label>
          <input type="text" id="rsvp-notes" name="notes" placeholder="optional" />
        </div>
      </div>

      <button class="btn btn-primary rsvp__submit" type="submit" id="rsvp-submit">
        Send RSVP <Icon name="right" size={18} />
      </button>
      <p class="rsvp__status" id="rsvp-status"></p>
    </form>

    <div class="rsvp__success" id="rsvp-success">
      <h3>You're on the list</h3>
      <p>Thanks — we can't wait to celebrate with you.</p>
    </div>
  </div>
</section>

<script>
  import confetti from 'canvas-confetti';

  const form = document.getElementById('rsvp-form') as HTMLFormElement | null;
  const status = document.getElementById('rsvp-status');
  const success = document.getElementById('rsvp-success');
  const submitBtn = document.getElementById('rsvp-submit') as HTMLButtonElement | null;

  function fireConfetti() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const colors = ['#AB0520', '#0C234B', '#ffffff'];
    confetti({ particleCount: 90, spread: 75, startVelocity: 42, origin: { y: 0.6 }, colors });
    setTimeout(() => confetti({ particleCount: 50, spread: 100, startVelocity: 30, origin: { y: 0.5 }, colors }), 180);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (status) {
      status.className = 'rsvp__status';
      status.textContent = 'Sending…';
    }
    if (submitBtn) submitBtn.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error('Form service error');
      form.style.display = 'none';
      success?.classList.add('show');
      fireConfetti();
    } catch {
      if (status) {
        status.className = 'rsvp__status err';
        status.textContent = "Something went wrong sending that — try again in a moment.";
      }
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
