---
// Everything below the personalized Hero. Identical across index / kylie / austin
// pages by design — edit content here once and it updates everywhere.
interface Props {
  /** bold/lead one graduate's card in the "Meet the graduates" section */
  featured?: 'kylie' | 'austin';
}
const { featured } = Astro.props;
const base = import.meta.env.BASE_URL;

const kylieCard = {
  key: 'kylie' as const,
  name: 'K Y L I E',
  degree: 'M.Ed. · School Counseling',
  img: 'grad-kylie.jpg',
  facts: [
    { label: 'WHAT I’M GRADUATING WITH:', body: 'Master of Education in School Counseling' },
    { label: 'NEXT STOP:', body: 'School counseling 🎓' },
  ],
};
const austinCard = {
  key: 'austin' as const,
  name: 'A U S T I N',
  degree: 'B.S. · Business Management',
  img: 'grad-austin.jpg',
  facts: [
    { label: 'FUN FACT:', body: 'This is Austin’s second bachelor’s degree.' },
    { label: 'THE GOAL:', body: 'Celebrate hard. Graduate harder.' },
  ],
};
const gradCards = featured === 'austin' ? [austinCard, kylieCard] : [kylieCard, austinCard];

// TODO: sign up free at https://formspree.io, create a form, and replace this ID
// with your real one (Settings → your form → "Your form's endpoint").
const FORMSPREE_ID = 'YOUR_FORM_ID';
---
<section class="container" style="padding-top:0">
  <div class="quick-grid">
    <a class="quick-card" href="#graduates"><div class="quick-icon">🎓</div><h3>THE GRADUATES</h3><p>Meet Kylie + Austin</p></a>
    <a class="quick-card" href="#weekend"><div class="quick-icon">📅</div><h3>THE WEEKEND</h3><p>Everything happening May 14–16</p></a>
    <a class="quick-card" href="#stay"><div class="quick-icon">🏨</div><h3>WHERE TO STAY</h3><p>Foothills, campus, downtown + Oro Valley</p></a>
    <a class="quick-card" href="#travel"><div class="quick-icon">✈️</div><h3>GETTING TO TUCSON</h3><p>TUS vs. PHX + getting around</p></a>
    <a class="quick-card" href="#party"><div class="quick-icon">🎉</div><h3>GRAD PARTY</h3><p>Saturday at The Mark Tucson</p></a>
    <a class="quick-card" href="#rsvp"><div class="quick-icon">💌</div><h3>RSVP</h3><p>Let us know you're coming</p></a>
  </div>
</section>

<section id="graduates">
<div class="container">
  <div class="section-head">
    <div><div class="eyebrow">Class of 2027</div><h2>Meet the graduates.</h2></div>
    <p>This is not a résumé page. It's the fun version: what we're graduating with, what's next, and why everyone should come celebrate.</p>
  </div>
  <div class="grads">
    {gradCards.map((g) => (
      <article class={`grad-card ${featured === g.key ? 'featured' : ''}`}>
        <div class="grad-img" style={`background-image:url('${base}images/${g.img}')`}></div>
        <div class="body">
          <div class="eyebrow">Graduate</div>
          <h3>{g.name}</h3>
          <div class="degree">{g.degree}</div>
          <p><strong>University of Arizona · Spring 2027</strong></p>
          {g.facts.map((f) => (
            <div class="funfact"><strong>{f.label}</strong><br />{f.body}</div>
          ))}
        </div>
      </article>
    ))}
  </div>
  <div class="timeline">
    <div><strong>2022 →</strong><span>College years</span></div>
    <div><strong>Classes →</strong><span>Late nights + lots of coffee</span></div>
    <div><strong>2027 →</strong><span>🎓 We did it.</span></div>
  </div>
</div>
</section>

<section class="band" id="weekend">
<div class="container">
  <div class="section-head">
    <div><div class="eyebrow">Save the dates</div><h2>The weekend.</h2></div>
    <p style="color:#d7dee8">Think of this like a festival schedule — come for the ceremony, stay for the party, and make a Tucson weekend out of it.</p>
  </div>
  <div class="weekend-grid">
    <article class="day-card"><div class="day-date">Friday · May 14</div><h3>🎓 University Commencement</h3><div class="time">7:30 PM</div><p class="detail"><strong>Casino Del Sol Stadium</strong><br>Come watch the Class of 2027 walk across the stage!</p><div class="badges"><span class="badge">Class of 2027</span><span class="badge">Bear Down</span></div></article>
    <article class="day-card"><div class="day-date">Saturday · May 15</div><h3>🎉 Graduation Party</h3><div class="time">TIME TBD</div><p class="detail"><strong>The Mark Tucson</strong><br>Pool · food · drinks · music · photos</p><div class="badges"><span class="badge">Pool</span><span class="badge">Party</span><span class="badge">Dress: Arizona casual</span></div></article>
    <article class="day-card"><div class="day-date">Sunday · May 16</div><h3>☀️ Brunch + Goodbyes</h3><div class="time">TBD</div><p class="detail"><strong>Optional</strong><br>Brunch for anyone still in Tucson before everyone heads home.</p><div class="badges"><span class="badge">Coffee</span><span class="badge">Brunch</span><span class="badge">See you later!</span></div></article>
  </div>
</div>
</section>

<section id="stay">
<div class="container">
  <div class="section-head">
    <div><div class="eyebrow">Tucson hotel guide</div><h2>Where should I stay?</h2></div>
    <p>There isn't one "right" area. Pick the Tucson version that fits your weekend: campus, desert resort, downtown, or more space up north.</p>
  </div>
  <div class="stay-grid">
    <article class="stay"><h3>🌵 The Foothills</h3><span class="tag">FAMILIES · RESORT FEEL</span><p><strong>Vibe:</strong> upscale · quiet · desert · mountain views</p><p><strong>Best for:</strong> families who want a nicer hotel or resort experience.</p><p><strong>Tradeoff:</strong> farther from campus, but beautiful and packed with dining/resort options.</p></article>
    <article class="stay"><h3>🎓 Near the University</h3><span class="tag">GRADUATION · WALKABILITY</span><p><strong>Vibe:</strong> college town · restaurants · coffee · Wildcats</p><p><strong>Best for:</strong> guests who want to be close to campus and Main Gate.</p><p><strong>Tradeoff:</strong> graduation weekend can be busy, so book early.</p></article>
    <article class="stay"><h3>🌆 Downtown Tucson</h3><span class="tag">FOOD · NIGHTLIFE · EXPLORING</span><p><strong>Vibe:</strong> local · historic · lively</p><p><strong>Best for:</strong> people who want restaurants, bars, arts and the streetcar nearby.</p><p><strong>Tradeoff:</strong> you'll be a little farther from campus than Main Gate.</p></article>
    <article class="stay"><h3>🌵 Oro Valley</h3><span class="tag">FAMILIES · AIRBNB · SPACE</span><p><strong>Vibe:</strong> quieter · mountains · suburban · spacious</p><p><strong>Best for:</strong> families/groups who want a larger rental or condo.</p><p><strong>Tradeoff:</strong> plan on driving to graduation activities.</p></article>
    <article class="stay"><h3>🌮 South Tucson</h3><span class="tag">FOOD · LOCAL CULTURE</span><p><strong>Vibe:</strong> compact · local · Mexican food</p><p><strong>Best for:</strong> exploring Tucson's food scene and staying close to south-side attractions.</p><p><strong>Tip:</strong> compare the exact lodging address, parking and transportation before booking.</p></article>
  </div>

  <div style="margin-top:60px">
    <div class="eyebrow">Actual places to start looking</div>
    <div class="hotel-grid">
      <div class="hotel"><h4>Graduate by Hilton Tucson</h4><small>Near UArizona · boutique/college vibe</small></div>
      <div class="hotel"><h4>Tucson Marriott University Park</h4><small>Near campus · Main Gate area</small></div>
      <div class="hotel"><h4>Arizona Inn</h4><small>Midtown · historic · garden setting</small></div>
      <div class="hotel"><h4>Hacienda del Sol Guest Ranch Resort</h4><small>Foothills · resort · mountain views</small></div>
      <div class="hotel"><h4>The Westin La Paloma</h4><small>Foothills · resort · pools/spa</small></div>
      <div class="hotel"><h4>The Leo Kent Hotel</h4><small>Downtown · modern · walkable</small></div>
      <div class="hotel"><h4>DoubleTree Downtown Convention Center</h4><small>Downtown · convention center</small></div>
      <div class="hotel"><h4>Holiday Inn Express Oro Valley</h4><small>Oro Valley · practical/family-friendly</small></div>
      <div class="hotel"><h4>Embassy Suites Paloma Village</h4><small>Foothills · suites · family-friendly</small></div>
    </div>
  </div>

  <div style="margin-top:45px">
    <h3 style="font-size:1.7rem;margin-bottom:15px">🏠 Hotel vs. Airbnb</h3>
    <table class="compare">
      <tr><th>Need</th><th>Hotel</th><th>Airbnb / Rental</th></tr>
      <tr><td>👨‍👩‍👧‍👦 Families</td><td>⭐⭐⭐</td><td>⭐⭐⭐⭐⭐</td></tr>
      <tr><td>🏊 Pool</td><td>⭐⭐⭐⭐</td><td>Depends</td></tr>
      <tr><td>🍳 Kitchen</td><td>Sometimes</td><td>Usually</td></tr>
      <tr><td>🚗 Parking</td><td>Usually</td><td>Depends</td></tr>
      <tr><td>💰 Groups</td><td>$$$</td><td>Can be cheaper</td></tr>
      <tr><td>🎓 Near campus</td><td>Easy to target</td><td>Depends on exact address</td></tr>
    </table>
  </div>

  <div style="margin-top:25px;background:var(--navy);color:#fff;padding:28px;border-radius:22px">
    <h3 style="font-size:1.5rem">OUR QUICK GUIDE</h3>
    <p style="margin-bottom:0">Couple / solo → <strong>near campus</strong> · Family of 4–6 → <strong>Foothills or Oro Valley</strong> · Big group → <strong>large rental</strong> · Food/nightlife → <strong>Downtown</strong></p>
  </div>
</div>
</section>

<section id="travel" style="background:#eef0f3">
<div class="container">
  <div class="section-head">
    <div><div class="eyebrow">Getting here</div><h2>Fly in. Bear down. Party.</h2></div>
    <p>Tucson is easy if you know which airport and transportation setup makes the most sense for your group.</p>
  </div>
  <div class="travel">
    <article class="travel-card"><div class="eyebrow">Option 01</div><h3>✈️ Fly into TUS</h3><div class="big">TUS</div><p><strong>Tucson International Airport</strong></p><p>Closest airport to the city and the simplest choice if you don't want to drive from Phoenix.</p><a class="btn btn-outline" href="https://www.google.com/maps/search/?api=1&query=Tucson+International+Airport" target="_blank">Open TUS in Maps ↗</a></article>
    <article class="travel-card"><div class="eyebrow">Option 02</div><h3>✈️ Fly into PHX</h3><div class="big">PHX</div><p><strong>Phoenix Sky Harbor</strong></p><p>More flight options can make PHX worthwhile. Plan on roughly a 2-hour drive to Tucson, depending on traffic.</p><a class="btn btn-outline" href="https://www.google.com/maps/dir/?api=1&origin=Phoenix+Sky+Harbor+International+Airport&destination=Tucson,+AZ" target="_blank">PHX → Tucson Directions ↗</a></article>
  </div>
  <div class="stay-grid" style="margin-top:20px">
    <div class="stay"><h3>🚗 Rental Car</h3><p>Best if you're staying in the Foothills, Oro Valley, or flying into Phoenix — especially for families and groups.</p></div>
    <div class="stay"><h3>🚕 Uber / Lyft</h3><p>Easy choice if you're staying near campus and mostly moving between graduation events.</p></div>
    <div class="stay"><h3>🚶 Walk + Streetcar</h3><p>Staying near UArizona/Main Gate or downtown makes it easier to leave the car parked and explore nearby.</p></div>
    <div class="stay"><h3>📍 The Mark Tucson</h3><p><strong>55 N. Park Ave., Tucson, AZ 85719</strong><br>That's where Saturday's party is happening.</p><a class="btn btn-outline" href="https://www.google.com/maps/search/?api=1&query=55+N+Park+Ave+Tucson+AZ+85719" target="_blank">Open Party Location ↗</a></div>
  </div>
</div>
</section>

<section id="party">
<div class="container">
  <div class="party">
    <div class="eyebrow" style="color:#ffd1d7">Saturday · May 15 · The Mark Tucson</div>
    <h2>WE'RE THROWING A PARTY.</h2>
    <p style="font-size:1.15rem;max-width:680px">Come celebrate the degrees, the late nights, the group chats, the coffee, and the fact that we somehow made it to graduation.</p>
    <div class="party-list"><span>🏊 POOL</span><span>🍔 FOOD</span><span>🥂 DRINKS</span><span>🎶 MUSIC</span><span>📸 PHOTOS</span></div>
    <h3 style="font-size:1.4rem">WHAT TO WEAR</h3>
    <p>Pool party / Arizona casual. Swimsuits welcome. Comfortable clothes encouraged. Come ready to celebrate.</p>
    <div class="cta-row"><a class="btn btn-light" href="https://www.google.com/maps/search/?api=1&query=55+N+Park+Ave+Tucson+AZ+85719" target="_blank">📍 Party Location</a></div>
  </div>
</div>
</section>

<section id="tucson">
<div class="container">
  <div class="section-head">
    <div><div class="eyebrow">If you're here for the weekend...</div><h2>Do Tucson things.</h2></div>
    <p>Don't spend the entire weekend inside a hotel. Tucson has desert, mountains, food, campus energy and some seriously good sunsets.</p>
  </div>
  <div class="attract-grid">
    <article class="attract"><div><h3>🌵 See the Desert</h3><p>Saguaro National Park + Sonoran Desert landscapes</p></div></article>
    <article class="attract"><div><h3>🌅 Chase a Sunset</h3><p>Gates Pass or the Tucson Mountains</p></div></article>
    <article class="attract"><div><h3>🌮 Eat Mexican Food</h3><p>Tucson is a UNESCO City of Gastronomy</p></div></article>
    <article class="attract"><div><h3>☕ Get Coffee</h3><p>Explore local cafés around campus + downtown</p></div></article>
    <article class="attract"><div><h3>🛍️ Explore</h3><p>4th Avenue · University Blvd · Downtown</p></div></article>
    <article class="attract"><div><h3>🌙 Go Out</h3><p>Campus and downtown have plenty of evening options</p></div></article>
  </div>
  <div style="margin-top:25px" class="stay-grid">
    <div class="stay"><h3>☀️ Saturday Morning</h3><p>Grab coffee → walk around campus → take photos at Old Main → lunch → get ready for the party.</p></div>
    <div class="stay"><h3>🌵 If You Have Half a Day</h3><p>Choose one: desert / downtown food + shopping / campus museums / scenic drive.</p></div>
  </div>
</div>
</section>

<section id="map" class="band">
<div class="container">
  <div class="section-head">
    <div><div class="eyebrow">Get oriented</div><h2>The Tucson map.</h2></div>
    <p style="color:#d7dee8">Not to scale — just enough to show guests how the weekend's major areas fit together.</p>
  </div>
  <div class="map-wrap">
    <div class="map">
      <div class="pin phx"><span><b>✈</b></span><label>PHX</label></div>
      <div class="pin oro"><span><b>🏠</b></span><label>Oro Valley</label></div>
      <div class="pin foothills"><span><b>🌵</b></span><label>Foothills</label></div>
      <div class="pin ua"><span><b>🎓</b></span><label>University of Arizona</label></div>
      <div class="pin mark"><span><b>🎉</b></span><label>The Mark</label></div>
      <div class="pin downtown"><span><b>🌆</b></span><label>Downtown</label></div>
      <div class="pin south"><span><b>🌮</b></span><label>South Tucson</label></div>
      <div class="pin tus"><span><b>✈</b></span><label>TUS</label></div>
    </div>
    <div class="map-legend">
      <span>🎓 UArizona</span><span>🎉 The Mark</span><span>✈ TUS</span><span>✈ PHX</span><span>🌵 Foothills</span><span>🏠 Oro Valley</span><span>🌆 Downtown</span><span>🌮 South Tucson</span>
    </div>
  </div>
</div>
</section>

<section id="rsvp">
<div class="container">
  <div class="section-head">
    <div><div class="eyebrow">Let us know you're coming</div><h2>RSVP</h2></div>
    <p>One RSVP covers your whole group. Update it anytime by submitting again.</p>
  </div>
  <form class="rsvp-card" id="rsvp-form" action={`https://formspree.io/f/${FORMSPREE_ID}`} method="POST">
    <div class="rsvp-grid">
      <div class="field">
        <label for="rsvp-name">Your name</label>
        <input type="text" id="rsvp-name" name="name" required />
      </div>
      <div class="field">
        <label for="rsvp-email">Email</label>
        <input type="email" id="rsvp-email" name="email" required />
      </div>
    </div>
    <div class="field" style="margin-top:16px">
      <label>What are you coming to?</label>
      <div class="checkbox-row">
        <label class="checkbox-pill"><input type="checkbox" name="events[]" value="Friday commencement" checked /> 🎓 Friday commencement</label>
        <label class="checkbox-pill"><input type="checkbox" name="events[]" value="Saturday party" checked /> 🎉 Saturday party</label>
        <label class="checkbox-pill"><input type="checkbox" name="events[]" value="Sunday brunch" /> ☀️ Sunday brunch</label>
      </div>
    </div>
    <div class="rsvp-grid" style="margin-top:16px">
      <div class="field">
        <label for="rsvp-guests">Total guests (incl. you)</label>
        <input type="number" id="rsvp-guests" name="guests" min="1" value="1" required />
      </div>
      <div class="field">
        <label for="rsvp-forwho">Here for</label>
        <select id="rsvp-forwho" name="forWho" style="font-family:inherit;font-size:1rem;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:var(--cream);color:var(--ink)">
          <option>Both Kylie & Austin</option>
          <option>Mainly Kylie</option>
          <option>Mainly Austin</option>
        </select>
      </div>
    </div>
    <div class="rsvp-grid full" style="margin-top:16px">
      <div class="field">
        <label for="rsvp-notes">Anything we should know? (dietary needs, arrival plans, etc.)</label>
        <textarea id="rsvp-notes" name="notes"></textarea>
      </div>
    </div>
    <button class="btn btn-primary rsvp-submit" type="submit">Send RSVP →</button>
    <p class="rsvp-status" id="rsvp-status"></p>
  </form>
</div>
</section>

<section>
<div class="container">
  <div class="section-head"><div><div class="eyebrow">Questions</div><h2>Good to know.</h2></div><p>A few details can stay flexible until closer to May.</p></div>
  <div class="faq">
    <details open><summary>Is the Friday ceremony confirmed?</summary><p>The University of Arizona's current 2027 commencement page lists Friday, May 14 at 7:30 p.m. at Casino Del Sol Stadium and notes that dates/times are subject to change.</p></details>
    <details><summary>What time is the Saturday party?</summary><p>TBD — this site intentionally leaves the time open so it can be updated once the party schedule is finalized.</p></details>
    <details><summary>Should I stay near campus?</summary><p>If graduation convenience is your priority, yes. Main Gate and the University district put you close to campus, restaurants and the Sun Link streetcar.</p></details>
    <details><summary>Should I rent a car?</summary><p>If you're staying in the Foothills/Oro Valley or flying into Phoenix, a rental car is the easiest setup. Near campus, rideshare and walking can work well.</p></details>
    <details><summary>Can I make this a Tucson vacation?</summary><p>Absolutely. Come early, stay through Sunday, and add desert, food, mountains, downtown or campus exploring around the graduation events.</p></details>
    <details><summary>Where is the party?</summary><p>The Mark Tucson, 55 N. Park Ave., Tucson, AZ 85719.</p></details>
    <details><summary>Do I need to RSVP?</summary><p>Yes please — it helps us plan food, seating and headcount. Use the RSVP form above; you can resubmit anytime if your plans change.</p></details>
  </div>
</div>
</section>

<script>
  const form = document.getElementById('rsvp-form') as HTMLFormElement | null;
  const status = document.getElementById('rsvp-status');
  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'rsvp-status show';
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          status.className = 'rsvp-status show ok';
          status.textContent = "Thanks! Your RSVP is in. 🎓";
          form.reset();
        } else {
          throw new Error('Form service error');
        }
      } catch {
        status.className = 'rsvp-status show err';
        status.textContent = "Something went wrong sending that — try again, or text us directly.";
      }
    });
  }
</script>
