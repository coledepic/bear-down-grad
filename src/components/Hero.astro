---
interface Props {
  kicker: string;
  headingTop: string;
  headingAccent: string;
  welcome: string;
  /** filename under /public/images/, e.g. "hero-kylie.jpg" — falls back to a navy gradient if missing */
  bgImage: string;
}
const { kicker, headingTop, headingAccent, welcome, bgImage } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="hero" data-reveal>
  <div class="hero__bg" style={`background-image:url('${base}/images/${bgImage}')`}></div>
  <div class="hero__content">
    <span class="hero__kicker">{kicker}</span>
    <h1 class="hero__title">{headingTop}<br><span class="accent">{headingAccent}</span></h1>
    <p class="hero__welcome">{welcome}</p>
    <div class="hero__pills">
      <span class="pill">Fri, May 14 · Commencement</span>
      <span class="pill">Sat, May 15 · The Party</span>
    </div>
    <div class="countdown" aria-label="Countdown to commencement">
      <div class="count-box"><b id="days">—</b><span>Days</span></div>
      <div class="count-box"><b id="hours">—</b><span>Hours</span></div>
      <div class="count-box"><b id="mins">—</b><span>Minutes</span></div>
      <div class="count-box"><b id="secs">—</b><span>Seconds</span></div>
    </div>
    <div class="hero__cta">
      <a class="btn btn-primary" href="#rsvp" data-scroll-to="rsvp">RSVP</a>
      <button type="button" class="see-details" data-goto="details">See the details →</button>
    </div>
  </div>
</section>
