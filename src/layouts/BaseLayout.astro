---
import '../styles/global.css';
import Icon from './../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  /** filename under /public/images/ used for the social/iMessage link preview */
  ogImage: string;
  /** which URL this is, for canonical + OG tags. '' = the duo/root page. */
  route?: '' | 'kylie' | 'austin';
  contactLine?: string;
}

const { title, description, ogImage, route = '', contactLine } = Astro.props;
// BASE_URL isn't guaranteed to have a trailing slash (it doesn't in dev) — normalize it once
// here so every concatenation below can safely assume `${base}/something`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = `https://coledepic.github.io${base}/${route ? route + '/' : ''}`;
const ogImageUrl = `https://coledepic.github.io${base}/images/${ogImage}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={siteUrl}>

<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={siteUrl}>
<meta property="og:image" content={ogImageUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageUrl}>

<meta name="theme-color" content="#0C234B">
<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
<link rel="icon" href={`${base}/favicon-32.png`} type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`}>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<slot name="intro" />

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="#top">Bear Down<span class="dot">.</span></a>
    <a class="header-cta" href="#rsvp">RSVP</a>
  </div>
</header>

<main>
<slot />
</main>

<footer class="site-footer">
  <div class="container">
    <div class="sign-off">Bear Down. We're Graduating.</div>
    <p class="meta">
      Kylie's M.Ed. · Austin's B.S.<br>
      University of Arizona · Class of 2027<br>
      May 14–16, 2027 · Tucson, Arizona
    </p>
    {contactLine && <p class="contact">{contactLine}</p>}
  </div>
</footer>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll-reveal for sections.
  const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (prefersReduced) {
    revealTargets.forEach((el) => el.classList.add('revealed'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    revealTargets.forEach((el) => io.observe(el));
  }

  // Countdown to Friday commencement, 7:30 PM Tucson time.
  const target = new Date('2027-05-14T19:30:00-07:00').getTime();
  const prev: Record<string, string> = {};
  function tick() {
    const d = Math.max(0, target - Date.now());
    const values: Record<string, number> = {
      days: Math.floor(d / 86400000),
      hours: Math.floor(d / 3600000) % 24,
      mins: Math.floor(d / 60000) % 60,
      secs: Math.floor(d / 1000) % 60,
    };
    for (const id of ['days', 'hours', 'mins', 'secs']) {
      const el = document.getElementById(id);
      if (!el) continue;
      const text = id === 'days' ? String(values[id]) : String(values[id]).padStart(2, '0');
      if (prev[id] !== text) {
        el.textContent = text;
        if (prev[id] !== undefined && !prefersReduced) {
          el.classList.remove('tick');
          void el.offsetWidth;
          el.classList.add('tick');
        }
        prev[id] = text;
      }
    }
  }
  tick();
  setInterval(tick, 1000);
</script>
</body>
</html>
