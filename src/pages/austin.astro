---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RsvpPanel from '../components/RsvpPanel.astro';
import DetailsView from '../components/DetailsView.astro';
---
<BaseLayout
  title="Austin's Graduation | UArizona 2027"
  description="Austin is graduating from the University of Arizona — May 14–16, 2027 in Tucson. RSVP and see the details."
  ogImage="og-austin.jpg"
  activePersona="austin"
>
  <div class="view active" data-view="rsvp">
    <Hero
      kicker="🎓 Austin's Graduation"
      headingTop="AUSTIN'S"
      headingAccent="GRADUATION."
      welcome="I'm graduating from the University of Arizona with my B.S. in Business Management, and I'd love for you to be in Tucson to celebrate with me."
      bgImage="hero-austin.jpg"
    />
    <RsvpPanel />
  </div>
  <div class="view" data-view="details">
    <DetailsView featured="austin" />
  </div>
</BaseLayout>
