---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SharedContent from '../components/SharedContent.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Kylie's Graduation Weekend | UArizona 2027"
  description="Kylie's University of Arizona graduation weekend guide — May 14–16, 2027 in Tucson, Arizona."
  activePage="kylie"
>
  <Hero
    kicker="🎓 Kylie's Graduation Weekend"
    headingTop="KYLIE'S"
    headingRed="GRADUATION."
    sub="I'm graduating from the University of Arizona with my Master's in School Counseling, and I'd love for you to be in Tucson to celebrate with me."
    pills={["Friday · May 14 · Commencement", "Saturday · May 15 · Grad Party", "Sunday · May 16 · Brunch / Goodbye"]}
    ctaPrimary={{ text: "Plan the Weekend", href: "#weekend" }}
    ctaSecondary={{ text: "RSVP", href: "#rsvp" }}
    bgImage="hero-kylie.jpg"
    crossLink={{ text: "Austin", href: `${base}austin/` }}
  />
  <SharedContent featured="kylie" />
</BaseLayout>
