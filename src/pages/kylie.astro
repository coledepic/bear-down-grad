---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RsvpPanel from '../components/RsvpPanel.astro';
import DetailsView from '../components/DetailsView.astro';
---
<BaseLayout
  title="Kylie's Graduation | UArizona 2027"
  description="Kylie is graduating from the University of Arizona — May 14–16, 2027 in Tucson. RSVP and see the details."
  ogImage="og-kylie.jpg"
  activePersona="kylie"
>
  <div class="view active" data-view="rsvp">
    <Hero
      kicker="🎓 Kylie's Graduation"
      headingTop="KYLIE'S"
      headingAccent="GRADUATION."
      welcome="I'm graduating from the University of Arizona with my Master's in School Counseling, and I'd love for you to be in Tucson to celebrate with me."
      bgImage="hero-kylie.jpg"
    />
    <RsvpPanel />
  </div>
  <div class="view" data-view="details">
    <DetailsView featured="kylie" />
  </div>
</BaseLayout>
